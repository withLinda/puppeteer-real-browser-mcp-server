{
  "name": "puppeteer-real-browser-mcp-server",
  "version": "1.6.0",
  "description": "MCP server for safe, detection-resistant browser automation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "rimraf dist",
    "clean:cache": "npm cache clean --force",
    "fix-cache-permissions": "echo 'Run: sudo chown -R $(whoami):$(id -gn) ~/.npm' && echo 'This fixes npm cache permission issues'",
    "clean:modules": "rm -rf node_modules",
    "clean:all": "npm run clean:modules && npm run clean:cache && npm run clean",
    "fresh-install": "npm run clean:all && npm install",
    "fresh-start": "npm run fresh-install && npm run build && npm start",
    "fresh-dev": "npm run fresh-install && npm run build && npm run dev",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "rebuild": "npm run clean && npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:safety": "vitest run --config vitest.safety.config.ts",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --coverage",
    "test:unit": "vitest run src",
    "test:regression:imports": "vitest run src/import-casing-regression.test.ts",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:e2e:watch": "vitest --config vitest.e2e.config.ts",
    "test:package:smoke": "tsx scripts/check-packaged-server.ts",
    "test:package:smoke:built": "tsx scripts/check-packaged-server.ts --skip-build",
    "test:full": "cd tests/mcp-testing && npm test",
    "test:performance": "node tests/performance/performance-tests.js",
    "test:debug": "node debug-server.js",
    "test:all": "npm run test:safety && npm run test:ci && npm run test:package:smoke",
    "test:dashboard": "node test-runner.js",
    "prepack": "npm run test:safety && npm run build && npm run test:package:smoke:built",
    "prepublishOnly": "npm run test:all && npm audit --omit=dev"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "chrome-launcher": "1.2.1",
    "ghost-cursor": "1.4.2",
    "rebrowser-puppeteer-core": "24.8.1",
    "turndown": "7.2.4",
    "xvfb": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "3.2.7",
    "@vitest/ui": "3.2.7",
    "rimraf": "6.1.3",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "browser-automation"
  ],
  "author": "withlinda13",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withLinda/puppeteer-real-browser-mcp-server.git"
  },
  "homepage": "https://github.com/withLinda/puppeteer-real-browser-mcp-server",
  "bugs": {
    "url": "https://github.com/withLinda/puppeteer-real-browser-mcp-server/issues"
  },
  "bin": {
    "puppeteer-real-browser-mcp-server": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "os": [
    "darwin",
    "linux",
    "win32"
  ]
}
